{
  "expo": {
    "name": "EPMAPS · Lecturas",
    "slug": "Prueba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/epmaps-icon.png",
    "scheme": "epmaps",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ec.edu.epmaps.lecturas"
    },
    "android": {
      "package": "ec.edu.epmaps.lecturas",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E8EFF3",
        "foregroundImage": "./assets/images/epmaps-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/epmaps-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8EFF3",
          "image": "./assets/images/epmaps-icon.png",
          "imageWidth": 130
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "EPMAPS necesita la cámara para documentar el medidor y conservar evidencia de la visita.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da542756-a5af-4927-a1fa-9a84a74d242a"
      }
    }
  }
}
